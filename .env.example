# ---------------------------------------------------------------------------
# ScoreSage - environment configuration
# Copy to `.env` (`cp .env.example .env`) and fill in the values you have.
#
# The app boots with an empty file and shows a setup checklist on the
# dashboard. MOCK_SPORTS=true serves two invented leagues with generated
# seasons so every page, the engine and the accuracy report can be exercised
# before any provider key exists. The AI layer is optional too: without a key
# predictions come from the statistical models alone.
# ---------------------------------------------------------------------------

# --- Core ------------------------------------------------------------------
# Host port the container is published on (7888 and 7889 are taken on the VPS).
PORT=7890
NODE_ENV=production
# Public origin, used for absolute URLs and the OAuth redirect. No trailing slash.
NEXT_PUBLIC_APP_URL=https://scoresage.wharveytech.com
# IANA timezone that defines "today" and the job times.
APP_TIMEZONE=Europe/London

# --- Database (SQLite via Prisma) -----------------------------------------
# Absolute path in Docker where /app/data is a mounted volume.
DATABASE_URL="file:/app/data/scoresage.db"
# For local development, prefer:
# DATABASE_URL="file:./dev.db"

# --- Dashboard access ------------------------------------------------------
# Recommended: Sign in with Google. Only the addresses listed here may open
# the dashboard (comma separated). Needs the Google OAuth client below.
DASHBOARD_ALLOWED_EMAILS=you@gmail.com
# Optional password fallback. Leave empty in production once Google sign-in
# works; while empty, password sign-in is disabled entirely.
DASHBOARD_PASSWORD=
# Signs the login cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=
# Days a sign-in lasts before Google (or the password) is asked again.
SESSION_TTL_DAYS=30
# Optional. Bearer token for POST /api/jobs/run if you drive jobs from cron
# instead of the built-in scheduler.
CRON_SECRET=

# --- Google OAuth (dashboard sign-in only) --------------------------------
# https://console.cloud.google.com - see DEPLOYMENT.md.
#   Credentials -> OAuth client ID -> Web application, redirect URI:
#     https://YOUR_DOMAIN/api/auth/google/callback
#     (plus http://localhost:3000/api/auth/google/callback for local work)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Data providers --------------------------------------------------------
# football-data.org (free: 10 req/min, 12 competitions) https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=
# API-Sports (API-Football, API-Rugby, ...; free: 100 req/day per API) https://dashboard.api-football.com
API_SPORTS_KEY=
# TheSportsDB v1 works with the public demo key; a Patreon key unlocks v2.
THESPORTSDB_KEY=123
# cricketdata.org (free: 100 hits/day)
CRICKETDATA_KEY=
# The Odds API (optional, free: 500 credits/month). Only read when ENABLE_ODDS=true.
ODDS_API_KEY=
ENABLE_ODDS=false
# Daily request budgets per provider. The sync jobs stop when a budget is
# spent and resume the next day; the Today page shows what is used.
PROVIDER_BUDGET_API_SPORTS=90
PROVIDER_BUDGET_FOOTBALL_DATA=2000
PROVIDER_BUDGET_THESPORTSDB=2000
PROVIDER_BUDGET_OPEN_METEO=2000
PROVIDER_BUDGET_CRICKETDATA=90
PROVIDER_BUDGET_ODDS_API=12

# --- AI --------------------------------------------------------------------
# gemini | anthropic | none. Switchable later in Settings.
AI_PROVIDER=gemini
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# USD per million tokens for the chosen model; seeds Settings, used for the
# cost figures computed from the real token counts each call reports.
AI_PRICE_INPUT_PER_M=0.75
AI_PRICE_OUTPUT_PER_M=3.75
# Monthly spending cap. When reached, AI calls stop and the algorithm continues.
AI_MONTHLY_BUDGET_USD=10

# --- Engine defaults (seed values only) -----------------------------------
# ALGORITHM | AI | HYBRID. Set per sport in Settings afterwards.
DEFAULT_PREDICTION_MODE=HYBRID
# How many days ahead fixtures get a prediction.
PREDICT_HORIZON_DAYS=7
# Weekly model refit time and daily fixture sync time (24h, APP_TIMEZONE).
REFIT_TIME=03:00
FIXTURE_SYNC_TIME=05:00
# Set to false when a host cron calls /api/jobs/run instead.
SCHEDULER_ENABLED=true
# true = serve invented leagues instead of any real provider. No keys needed.
MOCK_SPORTS=false
